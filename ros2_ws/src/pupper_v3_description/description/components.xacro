<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="define_components">


        <!-- Сначала задние ноги (stage 0-2), потом передние (stage 3-5). -->
        <joint name="leg_front_r_1">
            <param name="can_channel">2</param>
            <param name="can_id">1</param>

            <param name="homing_stage">5</param>
            <param name="homing_velocity">-1.5</param>
            <param name="homed_position">-0.312</param>
            <param name="post_homing_position">0.000</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-0.213</param>
            <param name="position_max">3.317</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_front_r_2">
            <param name="can_channel">2</param>
            <param name="can_id">2</param>

            <param name="homing_stage">4</param>
            <param name="homing_velocity">-1.5</param>
            <param name="homed_position">-0.42</param>
            <param name="post_homing_position">0.0</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-0.32</param>
            <param name="position_max">3.04</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_front_r_3">
            <param name="can_channel">2</param>
            <param name="can_id">3</param>

            <param name="homing_stage">3</param>
            <param name="homing_velocity">1.5</param>
            <param name="homed_position">0.605</param>
            <param name="post_homing_position">0.605</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-2.795</param>
            <param name="position_max">0.505</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_front_l_1">
            <param name="can_channel">1</param>
            <param name="can_id">1</param>

            <param name="homing_stage">5</param>
            <param name="homing_velocity">1.5</param>
            <param name="homed_position">0.627</param>
            <param name="post_homing_position">0.000</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-3.003</param>
            <param name="position_max">0.527</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_front_l_2">
            <param name="can_channel">1</param>
            <param name="can_id">2</param>

            <param name="homing_stage">4</param>
            <param name="homing_velocity">1.5</param>
            <param name="homed_position">0.42</param>
            <param name="post_homing_position">0.0</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>
            <!-- Удержание после хоуминга. Та же рука сдвигает это отведение на 8.8° против 1.3° у заднего левого. -->
            <param name="hold_kp">16.0</param>
            <param name="hold_kd">0.5</param>

            <param name="position_min">-3.04</param>
            <param name="position_max">0.32</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <!-- Слабее заднего левого отведения: kp_max поднят, стойка шлёт удвоенный kp. -->
            <param name="kp_max">40.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_front_l_3">
            <param name="can_channel">1</param>
            <param name="can_id">3</param>

            <param name="homing_stage">3</param>
            <param name="homing_velocity">-1.5</param>
            <param name="homed_position">-0.570</param>
            <param name="post_homing_position">-0.570</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-0.470</param>
            <param name="position_max">2.830</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_back_r_1">
            <param name="can_channel">4</param>
            <param name="can_id">1</param>

            <param name="homing_stage">2</param>
            <param name="homing_velocity">-1.5</param>
            <param name="homed_position">-1.673</param>
            <param name="post_homing_position">0.000</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-1.573</param>
            <param name="position_max">1.957</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">6.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_back_r_2">
            <param name="can_channel">4</param>
            <param name="can_id">2</param>

            <param name="homing_stage">1</param>
            <param name="homing_velocity">-1.5</param>
            <param name="homed_position">-0.420</param>
            <param name="post_homing_position">0.000</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-0.320</param>
            <param name="position_max">3.040</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">6.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_back_r_3">
            <param name="can_channel">4</param>
            <param name="can_id">3</param>

            <param name="homing_stage">0</param>
            <param name="homing_velocity">1.5</param>
            <param name="homed_position">0.780</param>
            <param name="post_homing_position">0.780</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-2.620</param>
            <param name="position_max">0.680</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">6.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_back_l_1">
            <param name="can_channel">3</param>
            <param name="can_id">1</param>

            <param name="homing_stage">2</param>
            <param name="homing_velocity">1.5</param>
            <param name="homed_position">1.778</param>
            <param name="post_homing_position">0.000</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-1.852</param>
            <param name="position_max">1.678</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">6.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_back_l_2">
            <param name="can_channel">3</param>
            <param name="can_id">2</param>

            <param name="homing_stage">1</param>
            <param name="homing_velocity">1.5</param>
            <param name="homed_position">0.42</param>
            <param name="post_homing_position">0.0</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-3.04</param>
            <param name="position_max">0.32</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">6.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_back_l_3">
            <param name="can_channel">3</param>
            <param name="can_id">3</param>

            <param name="homing_stage">0</param>
            <param name="homing_velocity">-1.5</param>
            <!-- Как у трёх других коленей: стойка (+0.52) лежит в 1.23 рад от упора хоуминга.
                 Ноль +0.535 ставил стойку прямо в упор, нога оставалась сложенной. -->
            <param name="homed_position">-0.815</param>
            <param name="post_homing_position">-0.815</param>
            <param name="homing_kp">5.5</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">2.0</param>

            <param name="position_min">-0.715</param>
            <param name="position_max">1.895</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">6.0</param>
            <param name="kp_max">20.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>


        <sensor name="imu_sensor">
            <!-- Rz(yaw)·Ry(pitch)·Rx(roll). 2026-09-25: без yaw наклон носом вниз шёл в крен;
                 с yaw=+90° завал на заднюю левую читался как нос и правый бок вниз — знак x и y был обратный.
                 2026-09-28: лево/право были инвертированы. yaw +180° при том же roll разворачивает
                 датчик вокруг вертикали: бока меняются местами, тангаж и верх не трогаются. -->
            <param name="yaw">1.57079632679</param>
            <param name="pitch">0</param>
            <param name="roll">-1.57079632679</param>

            <state_interface name="orientation.x"/>
            <state_interface name="orientation.y"/>
            <state_interface name="orientation.z"/>
            <state_interface name="orientation.w"/>
            <state_interface name="angular_velocity.x"/>
            <state_interface name="angular_velocity.y"/>
            <state_interface name="angular_velocity.z"/>
            <state_interface name="linear_acceleration.x"/>
            <state_interface name="linear_acceleration.y"/>
            <state_interface name="linear_acceleration.z"/>
        </sensor>

    </xacro:macro>

</robot>
