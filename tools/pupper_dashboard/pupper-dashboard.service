[Unit]
Description=Fenek dashboard (http://<ip>:8091)
After=robot.service network-online.target

[Service]
User=pi
ExecStart=/bin/bash /home/pi/pupperv3-monorepo/tools/pupper_dashboard/run.sh
KillSignal=SIGINT
TimeoutStopSec=10
Restart=always
RestartSec=3
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=multi-user.target
