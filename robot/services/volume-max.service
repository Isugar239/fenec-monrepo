[Unit]
Description=Set volume to 100%
After=sound.target
Wants=sound.target

[Service]
Type=oneshot
User=pi
Group=audio
# HiFiBerry DAC has no Master mixer; never fail boot because of that.
ExecStart=/bin/bash -c 'amixer -c sndrpihifiberry sset Digital 100% unmute 2>/dev/null; amixer sset Master 100% 2>/dev/null; amixer sset PCM 100% 2>/dev/null; true'
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
SupplementaryGroups=audio
Environment="PATH=/usr/bin:/usr/local/bin"
Environment="HOME=/home/pi"

[Install]
WantedBy=multi-user.target
